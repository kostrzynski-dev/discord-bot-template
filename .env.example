# ============================================================
# Discord Bot Runtime Configuration
# ============================================================

# ------------------------------------------------------------
# IMPORTANT
# ------------------------------------------------------------
# This file is an example configuration.
# Rename this file to `.env` before running the application.
# The bot will NOT read `.env.example` at runtime.

# ------------------------------------------------------------
# Environment
# ------------------------------------------------------------
# Allowed values:
# - dev   -> development mode (guild-only command sync)
# - prod  -> production mode (global command sync)
APP_ENV=dev


# ------------------------------------------------------------
# Discord Bot Token
# ------------------------------------------------------------
# Create your bot at:
# https://discord.com/developers/applications
DISCORD_TOKEN=PUT_YOUR_DISCORD_BOT_TOKEN_HERE


# ------------------------------------------------------------
# Developer Access
# ------------------------------------------------------------
# Comma-separated Discord user IDs with developer privileges
# Example: 123456789012345678,987654321098765432
DEVELOPER_IDS=


# ------------------------------------------------------------
# Developer Test Guild (DEV MODE ONLY)
# ------------------------------------------------------------
# Used only when APP_ENV=dev
# Commands will be synced ONLY to this guild
DEVELOPER_GUILD_ID=0
