# ============================================================
# Discord Bot Template — Git Ignore Rules
# ============================================================
# This file defines which files should NEVER be committed
# to the repository. It is part of the project's quality
# and security contract.
# ============================================================


# ------------------------------------------------------------
# 1. Environment configuration (runtime-specific)
# ------------------------------------------------------------
# Local environment variables and secrets.
# These files are meant to be edited by users locally.
# The example file is versioned as documentation.
.env*
!.env.example


# ------------------------------------------------------------
# 2. Python virtual environments
# ------------------------------------------------------------
# Virtual environments are machine-specific and reproducible
# from requirements.txt. They must never be committed.
.venv/
venv/
ENV/


# ------------------------------------------------------------
# 3. Python cache & bytecode
# ------------------------------------------------------------
# Generated automatically by Python during execution.
# They are not source code and differ between environments.
__pycache__/
*.py[cod]


# ------------------------------------------------------------
# 4. Logs & runtime artifacts
# ------------------------------------------------------------
# Logs are runtime output. They may contain sensitive
# diagnostic data and must not be versioned.
*.log
logs/


# ------------------------------------------------------------
# 5. IDE & editor configuration
# ------------------------------------------------------------
# Editor-specific files should never affect the repository.
.vscode/
.idea/


# ------------------------------------------------------------
# 6. Operating system generated files
# ------------------------------------------------------------
# Files automatically created by the OS.
.DS_Store
Thumbs.db


# ------------------------------------------------------------
# 7. Build & distribution artifacts
# ------------------------------------------------------------
# Generated during packaging or distribution.
# Not relevant for source control.
dist/
build/
*.egg-info/


# ------------------------------------------------------------
# 8. Test & coverage artifacts
# ------------------------------------------------------------
# Generated by test and coverage tools.
.coverage
htmlcov/


# ------------------------------------------------------------
# 9. Local review snapshots (developer-only)
# ------------------------------------------------------------
tools/snapshot/docs/PROJECT_SNAP.md